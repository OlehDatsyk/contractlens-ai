# ContractLens AI - example configuration
# Copy to backend/.env for local development (the Start App scripts do this for you and generate secrets).
# NEVER commit a real .env file. All values below are placeholders.

# --- General ---------------------------------------------------------------------------------------------------
ENVIRONMENT=development                # development | production
FRONTEND_URL=http://localhost:5173     # used for links in emails and CORS
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=                          # extra comma-separated origins (only needed when frontend and API differ)
TRUST_PROXY_HEADERS=false              # true behind a trusted reverse proxy (e.g. Render) for correct client IPs
DOCS_ENABLED=true                      # OpenAPI docs at /api/docs
REGISTRATION_ENABLED=true
LOG_LEVEL=INFO

# --- Security (generate real values; see INSTRUCTION.md) -----------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=                        # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
RATE_LIMIT_ENABLED=true

# --- Database ------------------------------------------------------------------------------------------------------
# Local Docker database (docker compose up -d db) listens on 127.0.0.1:5437
DATABASE_URL=postgresql+psycopg://contractlens:contractlens@127.0.0.1:5437/contractlens
DATABASE_SCHEMA=                       # optional: keep all tables in this PostgreSQL schema (to share an instance)

# --- Uploads and processing ----------------------------------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
PROCESSING_TIMEOUT_SECONDS=180
OCR_ENABLED=true                       # used only if the Tesseract binary is installed

# --- Document storage ----------------------------------------------------------------------------------------------
STORAGE_BACKEND=local                  # local | database | s3
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_PERSISTENT=false         # set true only when LOCAL_STORAGE_PATH is a persistent disk
# S3-compatible private bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO) when STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=               # empty for AWS S3, e.g. https://<account>.r2.cloudflarestorage.com for R2
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto

# --- AI (optional; the app works without it) -----------------------------------------------------------------------
AI_PROVIDER=none                       # none | openai | anthropic | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=60000               # caps tokens sent per analysis
AI_MAX_OUTPUT_TOKENS=4000

# --- Email (optional; nothing is sent unless configured) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Background work -----------------------------------------------------------------------------------------------
RUN_WORKER_IN_API=true                 # false when running a separate worker (python -m app.worker)
REMINDER_CHECK_MINUTES=30
RETENTION_CHECK_MINUTES=360
